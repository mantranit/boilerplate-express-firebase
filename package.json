{
  "name": "boilerplate-express-firebase",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "nodemon src/server.ts",
    "build": "rimraf dist && npx tsc",
    "serve": "cross-env NODE_ENV=production node dist/server.js",
    "db:up": "npx typeorm-ts-node-commonjs migration:run -d ./src/database/data-source.ts",
    "db:down": "npx typeorm-ts-node-commonjs migration:revert -d ./src/database/data-source.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mantranit/boilerplate-express-firebase.git"
  },
  "keywords": [],
  "author": "",
