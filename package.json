  "bugs": {
    "url": "https://github.com/mantranit/boilerplate-express-firebase/issues"
  },
  "homepage": "https://github.com/mantranit/boilerplate-express-firebase#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "path": "^0.12.7",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.1.13",
    "socket.io": "^4.5.4",
    "typeorm": "^0.3.20",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.14",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.11.11",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
